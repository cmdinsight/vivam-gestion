datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id           String   @id @default(cuid())
  usuario      String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
}

enum EstadoCliente {
  PROSPECTO
  ACTIVO
  PAUSADO
  BAJA
}

enum PlanContratado {
  ESENCIAL_LUNES_VIERNES
  ESENCIAL_COMPLETO
  EXTENDIDO
  INTEGRAL
  VIVAM_NOCTURNO
}

enum Modalidad {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum TipoFacturacion {
  PLAN_MENSUAL
  POR_HORA
}

model Cliente {
  id                  String           @id @default(cuid())
  nombrePaciente      String
  familiaResponsable  String
  contacto            String?
  zona                String?
  facturacion         TipoFacturacion  @default(PLAN_MENSUAL)
  plan                PlanContratado?
  fechaInicio         DateTime
  modalidad           Modalidad?
  precioMensual       Decimal          @db.Decimal(12, 2)
  estado              EstadoCliente    @default(PROSPECTO)
  notas               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  cobros              Cobro[]
  asignaciones        AsignacionFija[]
  turnos              Turno[]
  notasGuardia        NotaGuardia[]
  procederes          ProcederEjecutado[]
  reportesDiarios     ReporteDiario[]
  valoracion          ValoracionInicial?
}

enum EstadoCobro {
  PENDIENTE
  COBRADO
  ATRASADO
}

model Cobro {
  id               String      @id @default(cuid())
  clienteId        String
  cliente          Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mes              String
  montoEsperado    Decimal     @db.Decimal(12, 2)
  fechaVencimiento DateTime
  estado           EstadoCobro @default(PENDIENTE)
  montoCobrado     Decimal?    @db.Decimal(12, 2)
  fechaCobro       DateTime?
  notas            String?
  createdAt        DateTime    @default(now())

  @@unique([clienteId, mes])
}

enum TipoTarifa {
  HORA
  MENSUAL
}

enum EstadoTrabajador {
  ACTIVO
  INACTIVO
}

model Trabajador {
  id                            String                 @id @default(cuid())
  nombre                        String
  contacto                      String?
  fechaIngreso                  DateTime
  categoriaLaboral              String?
  tipoTarifa                    TipoTarifa
  tarifa                        Decimal                @db.Decimal(12, 2)
  cuentaBancaria                String?
  diasLicenciaAnualesOverride   Int?
  proximaFechaLicenciaEstimada  DateTime?
  estado                        EstadoTrabajador       @default(ACTIVO)
  notas                         String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  asignaciones                  AsignacionFija[]
  turnos                        Turno[]
  liquidaciones                 LiquidacionMensual[]
  movimientos                   MovimientoProvision[]
  reportesDiarios               ReporteDiario[]
  acceso                        CuidadorAcceso?
}

// Vincula un cliente con un cuidador fijo según un patrón semanal recurrente
// (ej. lunes a viernes 08:00-16:00). A partir de esto se generan los Turnos.
model AsignacionFija {
  id            String     @id @default(cuid())
  clienteId     String
  cliente       Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  trabajadorId  String
  trabajador    Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  diasSemana    Int[] // 0=domingo … 6=sábado
  horaInicio    String // "HH:MM"
  horaFin       String // "HH:MM" (puede cruzar medianoche si horaFin < horaInicio)
  fechaInicio   DateTime
  fechaFin      DateTime?
  activa        Boolean    @default(true)
  notas         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  turnos        Turno[]
}

enum EstadoTurno {
  PROGRAMADO
  TRABAJADO
  NO_TRABAJADO
}

// Un turno concreto en una fecha puntual. Se genera automáticamente a partir
// de una AsignacionFija, o se crea manualmente para cobertura extra puntual.
// Una vez editado (editado=true) la regeneración nunca lo vuelve a tocar.
model Turno {
  id             String          @id @default(cuid())
  trabajadorId   String
  trabajador     Trabajador      @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  clienteId      String?
  cliente        Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  asignacionId   String?
  asignacion     AsignacionFija? @relation(fields: [asignacionId], references: [id], onDelete: SetNull)
  fecha          DateTime
  mes            String
  horaInicio     String
  horaFin        String
  horas          Decimal         @db.Decimal(6, 2)
  estado         EstadoTurno     @default(PROGRAMADO)
  motivo         String?
  editado        Boolean         @default(false)
  origenManual   Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([asignacionId, fecha])
}

model LiquidacionMensual {
  id                 String     @id @default(cuid())
  trabajadorId       String
  trabajador         Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  mes                String
  horasTotales       Decimal    @db.Decimal(8, 2)
  sueldoNominal      Decimal    @db.Decimal(12, 2)
  bpsPatronal        Decimal    @db.Decimal(12, 2)
  bse                Decimal    @db.Decimal(12, 2)
  aguinaldoProvision Decimal    @db.Decimal(12, 2)
  licenciaProvision  Decimal    @db.Decimal(12, 2)
  procesadoEn        DateTime   @default(now())

  @@unique([trabajadorId, mes])
}

enum TipoProvision {
  AGUINALDO
  LICENCIA
}

model MovimientoProvision {
  id           String        @id @default(cuid())
  trabajadorId String
  trabajador   Trabajador    @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  tipo         TipoProvision
  mes          String
  monto        Decimal       @db.Decimal(12, 2)
  esPago       Boolean       @default(false)
  descripcion  String?
  fecha        DateTime      @default(now())
}

model Configuracion {
  id                 Int      @id @default(1)
  bpsPatronalPct     Decimal  @db.Decimal(5, 2) @default(19.5)
  bsePct             Decimal  @db.Decimal(5, 2) @default(3)
  aguinaldoDivisor   Decimal  @db.Decimal(5, 2) @default(12)
  licenciaDiasAnio   Int      @default(20)
  // % de licencia + salario vacacional sobre el sueldo nominal (a confirmar con el contador)
  licenciaPct        Decimal  @db.Decimal(5, 2) @default(8.33)
  // Costo total fijo por hora de cuidador (ya incluye BPS+BSE+aguinaldo+licencia)
  tarifaHoraDiurna   Decimal  @db.Decimal(12, 2) @default(230)
  tarifaHoraNocturna Decimal  @db.Decimal(12, 2) @default(273)
  // Precio al cliente por hora sin plan mensual (sin IVA); el IVA se aplica fijo al 10%
  tarifaHoraClienteDiurna   Decimal @db.Decimal(12, 2) @default(350)
  tarifaHoraClienteNocturna Decimal @db.Decimal(12, 2) @default(455)
  updatedAt          DateTime @updatedAt
}

// Datos maestros de cada uno de los 4 planes oficiales Vivam. precioBase es el
// precio de tarifa llena (100%, sin descuento de modalidad); el precio final
// al cliente sale de precioBase * (1 - descuento de la modalidad elegida).
model PlanConfig {
  plan              PlanContratado @id
  horasMes          Int
  precioBase        Decimal        @db.Decimal(12, 2)
  costoCuidadorMes  Decimal        @db.Decimal(12, 2)
  cupoProcederesMes Int
  // Si true, se advierte (sin bloquear) al contratar este plan en modalidad ANUAL
  alertaAnual       Boolean        @default(false)
  // Ídem para SEMESTRAL. Se agregó al incorporar los costos de enfermería y
  // guardia médica: con el modelo completo, el semestral también cae por
  // debajo del piso de margen en casi todos los planes.
  alertaSemestral   Boolean        @default(false)
  updatedAt         DateTime       @updatedAt
}

// Descuento total de cada modalidad de compromiso sobre el precioBase del plan.
model ModalidadConfig {
  modalidad    Modalidad @id
  descuentoPct Decimal   @db.Decimal(5, 2)
  updatedAt    DateTime  @updatedAt
}

enum UnidadFacturacion {
  POR_VISITA
  POR_MES
}

// Catálogo de servicios extra / procederes cotizables aparte del plan
// (ej. visita médica domiciliaria, reporte PDF mensual). Todavía no está
// conectado a la facturación de Cobros — es solo el catálogo de precios.
model ExtraServicio {
  id           String            @id @default(cuid())
  nombre       String
  precioSinIva Decimal           @db.Decimal(12, 2)
  unidad       UnidadFacturacion
  aplicaIva    Boolean           @default(true)
  activo       Boolean           @default(true)
  descripcion  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}


// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO DIRECCIÓN MÉDICA Y ENFERMERÍA (profesionales facturadores)
//
// Un Profesional NO es un Trabajador. Trabajador modela al cuidador
// dependiente, con BPS/BSE/aguinaldo/licencia y liquidación laboral.
// Un Profesional factura a Vivam: emite factura contra un total liquidado,
// no genera cargas sociales, licencia ni aguinaldo. Por eso van separados —
// mezclarlos metería a médicos y enfermeros dentro de procesarMes() y del
// cálculo de provisiones, donde no corresponden.
// ═══════════════════════════════════════════════════════════════════════════

enum RolProfesional {
  MEDICO
  ENFERMERO
}

enum EstadoProfesional {
  ACTIVO
  INACTIVO
}

model Profesional {
  id              String            @id @default(cuid())
  nombre          String
  rol             RolProfesional
  especialidad    String?
  contacto        String?
  cajaProfesional String?
  rutMonotributo  String?
  // Innegociable antes de asignarle un paciente. Si está vencido o vacío,
  // la UI lo marca en rojo.
  seguroRcVence   DateTime?
  cuentaBancaria  String?
  // Solo médicos: base mensual por disponibilidad y tope de liquidación.
  // Si quedan en null se usan los valores de ConfiguracionFacturadores.
  baseMensual     Decimal?          @db.Decimal(12, 2)
  topeMensual     Decimal?          @db.Decimal(12, 2)
  // Solo enfermeros: % del valor de lista del proceder que cobra.
  // Si queda en null se usa el de ConfiguracionFacturadores.
  pctProceder     Decimal?          @db.Decimal(5, 2)
  zonas           String?
  estado          EstadoProfesional @default(ACTIVO)
  notas           String?
  // Login propio al portal de facturadores. Nulo hasta que el admin le
  // configura un acceso desde Profesionales; sin usuario no puede loguearse.
  usuario         String?           @unique
  passwordHash    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  notasGuardia    NotaGuardia[]
  procederes      ProcederEjecutado[]
  turnosTitular   TurnoGuardia[]          @relation("GuardiaTitular")
  turnosBackup    TurnoGuardia[]          @relation("GuardiaBackup")
  liquidaciones   LiquidacionFacturador[]
  valoraciones    ValoracionInicial[]

  @@index([rol, estado])
}

enum TipoLlamada {
  PROGRAMADA
  GUARDIA
  EMERGENCIA
}

enum QuienLlama {
  CUIDADOR
  ENFERMERO
  FAMILIAR
}

// Registro de cada consulta telefónica atendida por el médico de guardia.
// REGLA DE NEGOCIO: si notaCargada = false, montoLiquidado queda en 0 y la
// llamada no entra en la liquidación del médico. Sin nota en la historia
// clínica, la llamada no se paga.
model NotaGuardia {
  id               String       @id @default(cuid())
  fecha            DateTime
  mes              String
  medicoId         String
  medico           Profesional  @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  clienteId        String?
  cliente          Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  quienLlama       QuienLlama
  tipo             TipoLlamada
  motivo           String
  datosObjetivos   String?
  valoracion       String?
  conducta         String?
  signosAlarma     String?
  derivoEmergencia Boolean      @default(false)
  avisoFamilia     Boolean      @default(false)
  notaCargada      Boolean      @default(false)
  cargadaEn        DateTime?
  montoLiquidado   Decimal      @db.Decimal(12, 2) @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  procederes       ProcederEjecutado[]

  @@index([mes, medicoId])
  @@index([clienteId, fecha])
}

// Cada proceder de enfermería ejecutado. El nº del mes por paciente, si entra
// o no en el cupo del plan, lo que se le cobra al cliente y lo que se le paga
// al enfermero se calculan al registrarlo y quedan congelados en la fila.
model ProcederEjecutado {
  id             String       @id @default(cuid())
  fecha          DateTime
  mes            String
  clienteId      String
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  enfermeroId    String
  enfermero      Profesional  @relation(fields: [enfermeroId], references: [id], onDelete: Cascade)
  proceder       String
  notaGuardiaId  String?
  notaGuardia    NotaGuardia? @relation(fields: [notaGuardiaId], references: [id], onDelete: SetNull)
  plan           PlanContratado?
  numeroDelMes   Int
  cupoPlan       Int
  dentroDeCupo   Boolean
  montoCliente   Decimal      @db.Decimal(12, 2)
  montoEnfermero Decimal      @db.Decimal(12, 2)
  facturado      Boolean      @default(false)
  notas          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([mes, enfermeroId])
  @@index([clienteId, mes])
}

// Quién está a la orden cada mes. El backup no es opcional en la práctica:
// sin backup no se puede sostener la promesa de respaldo 24/7.
model TurnoGuardia {
  id              String       @id @default(cuid())
  mes             String
  bloque          String
  medicoTitularId String
  medicoTitular   Profesional  @relation("GuardiaTitular", fields: [medicoTitularId], references: [id], onDelete: Cascade)
  medicoBackupId  String?
  medicoBackup    Profesional? @relation("GuardiaBackup", fields: [medicoBackupId], references: [id], onDelete: SetNull)
  franjaHoraria   String       @default("24/7")
  notas           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([mes, bloque])
}

// Cierre mensual de un profesional facturador. Idempotente por profesional+mes.
model LiquidacionFacturador {
  id              String      @id @default(cuid())
  profesionalId   String
  profesional     Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  mes             String
  base            Decimal     @db.Decimal(12, 2) @default(0)
  variable        Decimal     @db.Decimal(12, 2) @default(0)
  cantidadEventos Int         @default(0)
  subtotal        Decimal     @db.Decimal(12, 2) @default(0)
  tope            Decimal?    @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2) @default(0)
  pagado          Boolean     @default(false)
  fechaPago       DateTime?
  procesadoEn     DateTime    @default(now())

  @@unique([profesionalId, mes])
}

// Parámetros económicos del módulo. Fila única (id = 1), igual que Configuracion.
model ConfiguracionFacturadores {
  id                  Int      @id @default(1)
  // Médico de guardia
  baseMensualMedico   Decimal  @db.Decimal(12, 2) @default(8000)
  tarifaProgramada    Decimal  @db.Decimal(12, 2) @default(400)
  tarifaGuardia       Decimal  @db.Decimal(12, 2) @default(700)
  tarifaEmergencia    Decimal  @db.Decimal(12, 2) @default(1200)
  topeMensualMedico   Decimal  @db.Decimal(12, 2) @default(25000)
  // Lo que se le paga al médico por hacer la valoración inicial a domicilio.
  // Es gratis para el cliente (no genera Cobro): pérdida inicial para la
  // empresa, asumida como costo de adquisición.
  precioValoracionInicial Decimal @db.Decimal(12, 2) @default(2500)
  // Enfermería. precioProcederSinIva es la fuente de verdad del módulo:
  // de acá salen tanto lo que se le cobra al cliente por un proceder fuera
  // de cupo como lo que se le paga al enfermero (pctEnfermero sobre este valor).
  pctEnfermero        Decimal  @db.Decimal(5, 2) @default(50)
  precioProcederSinIva Decimal @db.Decimal(12, 2) @default(1500)
  updatedAt           DateTime @updatedAt
}

// Credenciales de portal para un Trabajador (cuidador). Tabla aparte, no
// usuario/passwordHash directo en Trabajador: ese modelo ya se consulta sin
// restriccion de campos en muchos lugares (dashboard, liquidacion, turnos),
// asi que separar el hash evita tener que auditar cada uno de esos call
// sites para que nunca lo devuelvan en un JSON.
model CuidadorAcceso {
  id           String     @id @default(cuid())
  trabajadorId String     @unique
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  usuario      String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Reporte que carga el cuidador al final de cada turno (hoy lo mandan por
// WhatsApp a mano; esto lo digitaliza). Un reporte por cuidador+cliente+dia:
// si se vuelve a cargar el mismo dia, se actualiza en vez de duplicar.
model ReporteDiario {
  id                     String     @id @default(cuid())
  clienteId              String
  cliente                Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  trabajadorId           String
  trabajador             Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  fecha                  DateTime
  mes                    String
  estadoGeneral          String?    @db.Text
  animo                  String?    @db.Text
  alimentacion           String?    @db.Text
  medicacionAdministrada String?    @db.Text
  movilidad              String?    @db.Text
  higiene                String?    @db.Text
  observaciones          String?    @db.Text
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([clienteId, trabajadorId, fecha])
  @@index([mes, clienteId])
}

enum TipoMovilidad {
  INDEPENDIENTE
  ASISTIDO
  SILLA_RUEDAS
  POSTRADO
}

enum TipoContinencia {
  CONTINENTE
  OCASIONAL
  TOTAL
  PANAL
}

enum TipoAyuda {
  INDEPENDIENTE
  PARCIAL
  TOTAL
  SONDA
}

// Ficha médica del cliente: la valoración inicial que hace el médico en la
// primera visita a domicilio, antes de armar la cotización del plan. Un
// registro por cliente (se edita si hay que actualizarla, no se versiona).
// Corresponde 1 a 1 con el formulario en papel
// "Vivam_Valoracion_Inicial_Paciente.docx".
model ValoracionInicial {
  id        String      @id @default(cuid())
  clienteId String      @unique
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  medicoId  String
  medico    Profesional @relation(fields: [medicoId], references: [id])
  fecha     DateTime
  mes       String
  // Lo que se le liquida al médico por esta valoración. Congelado al
  // crearla (precioValoracionInicial vigente ese día); si se edita después
  // no se vuelve a cobrar ni se recalcula.
  montoLiquidado Decimal @db.Decimal(12, 2) @default(0)

  // 1. Datos del paciente (lo que no está ya en Cliente)
  cedulaIdentidad        String?
  direccion              String?
  medicoTratanteHabitual String?
  institucionSalud       String?
  contactoEmergencia     String?

  // 2. Datos de quien solicita el servicio
  solicitanteNombre    String?
  solicitanteVinculo   String?
  solicitanteTelefono  String?
  solicitanteEmail     String?
  motivoConsulta       String? @db.Text

  // 3. Antecedentes médicos
  patologiasCronicas        String? @db.Text
  cirugiasRecientes         String? @db.Text
  alergias                  String? @db.Text
  caidasUltimoAnio          String? @db.Text
  antecedentesPsiquiatricos String? @db.Text

  // 5. Evaluación funcional
  movilidad        TipoMovilidad?
  movilidadObs     String?         @db.Text
  continencia      TipoContinencia?
  continenciaObs   String?         @db.Text
  alimentacionTipo TipoAyuda?
  alimentacionObs  String?         @db.Text
  higiene          TipoAyuda?
  higieneObs       String?         @db.Text

  // 6. Evaluación cognitiva breve
  orientacion           String? @db.Text
  memoria               String? @db.Text
  riesgoFugaCognitivo   String? @db.Text
  capacidadComunicacion String? @db.Text

  // 7. Riesgos identificados
  riesgoCaidas          Boolean @default(false)
  riesgoEscaras         Boolean @default(false)
  riesgoAspiracion      Boolean @default(false)
  riesgoFuga            Boolean @default(false)
  riesgoDescompensacion Boolean @default(false)
  riesgoOtro            String?

  // 8. Necesidades especiales y dispositivos
  dietaEspecial       String?
  oxigenoDomiciliario String?
  sonda               String?
  ostomia             String?
  otrosDispositivos   String?

  // 9. Entorno domiciliario
  tipoVivienda            String?
  barrerasArquitectonicas String?
  banoAdaptado            String?
  conviveConOtros         String?

  // 10. Plan de cuidado sugerido
  planRecomendado           PlanContratado?
  justificacionClinica      String?         @db.Text
  cupoProcederesRecomendado Int?
  observacionesCuidador     String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicamentos MedicamentoValoracion[]

  @@index([mes, medicoId])
}

model MedicamentoValoracion {
  id           String            @id @default(cuid())
  valoracionId String
  valoracion   ValoracionInicial @relation(fields: [valoracionId], references: [id], onDelete: Cascade)
  farmaco      String
  dosis        String?
  horario      String?
  via          String?
}
